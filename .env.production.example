# .env.production.example
# Copy to .env.production and fill in real values before deploying.
# NEVER commit .env.production to git.

# ── Database ─────────────────────────────────────────────────────────
# Strong passwords (generate with: openssl rand -base64 32)
CREATORPROOF_POSTGRES_OWNER_PASSWORD=CHANGE_ME_strong_password_1
CREATORPROOF_POSTGRES_RUNTIME_PASSWORD=CHANGE_ME_strong_password_2

# ── API Auth ─────────────────────────────────────────────────────────
# API key for your dev tenant (generate with: openssl rand -hex 32)
CREATORPROOF_DEV_API_KEY=CHANGE_ME_api_key
# Pepper for API key hashing (generate with: openssl rand -hex 16)
CREATORPROOF_API_KEY_PEPPER=CHANGE_ME_pepper

# ── Statement Signing ────────────────────────────────────────────────
# Ed25519 private key in hex (generate with: openssl rand -hex 32)
CREATORPROOF_STATEMENT_SIGNING_ENABLED=true
CREATORPROOF_STATEMENT_SIGNING_KID=creatorproof-prod-ed25519-1
CREATORPROOF_STATEMENT_SIGNING_PRIVATE_KEY_HEX=CHANGE_ME_ed25519_private_key_hex
CREATORPROOF_TRUSTED_ISSUER_KEY_SHA256=CHANGE_ME_after_generating_signing_key

# ── Blockchain (EAS on Base Sepolia) ─────────────────────────────────
# Leave empty to disable on-chain anchoring
CREATORPROOF_EAS_PRIVATE_KEY=
CREATORPROOF_EAS_SCHEMA_UID=
CREATORPROOF_EAS_CHECKPOINT_SCHEMA_UID=
CREATORPROOF_PROOF_ANCHOR_MODE=off
CREATORPROOF_PROOF_REQUIRE_CHAIN=false

# ── Environment ──────────────────────────────────────────────────────
CREATORPROOF_ENVIRONMENT=production
CREATORPROOF_DEV_AUTH_ENABLED=false

# ── Optional: Sightengine AI Detection ───────────────────────────────
CREATORPROOF_SIGHTENGINE_API_USER=
CREATORPROOF_SIGHTENGINE_API_SECRET=

# ── Optional: ML Models ──────────────────────────────────────────────
# Set to "off" to skip ML-based detection (saves RAM on smaller VMs)
CREATORPROOF_SYNTHETIC_DETECTOR=off

# ── Web Build Args ───────────────────────────────────────────────────
# These are baked into the Next.js build at compile time
NEXT_PUBLIC_CREATORPROOF_ISSUER_KEY_FINGERPRINT_SHA256=
NEXT_PUBLIC_CREATORPROOF_DEPLOYMENT_FINGERPRINT_SHA256=
NEXT_PUBLIC_CREATORPROOF_ISSUER=creatorproof
