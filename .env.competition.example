# CreatorProof competition profile (BCOLBD blockchain segment)
#
# Copy to `.env`, fill the deployment tuple, then run:
#   uv run --no-sync python -m scripts.competition_preflight
#   uv run --no-sync python -m scripts.blockchain_acceptance
#
# This profile is deliberately fail-closed. Anchoring never degrades to a local
# Merkle receipt, so if the chain is unreachable the demo says so out loud
# instead of quietly presenting a local log as if it were a blockchain.
#
# Two variants are given for the network tuple: the local Ganache harness and
# Base Sepolia. Use exactly one; do not mix values from both.

CREATORPROOF_ENVIRONMENT=development
CREATORPROOF_DEV_API_KEY=replace-with-a-long-random-demo-key
CREATORPROOF_DEV_AUTH_ENABLED=true
CREATORPROOF_API_KEY_PEPPER=replace-with-a-long-random-pepper
CREATORPROOF_DATABASE_URL=sqlite:///./creatorproof.db
CREATORPROOF_STORAGE_ROOT=./data
CREATORPROOF_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Signed statements. The competition acceptance check refuses an ephemeral key,
# because a key that dies with the process cannot support a later audit.
# Generate with: python -c "import os;print(os.urandom(32).hex())"
# ---------------------------------------------------------------------------
CREATORPROOF_STATEMENT_SIGNING_ENABLED=true
CREATORPROOF_STATEMENT_SIGNING_KID=creatorproof-competition-ed25519-1
CREATORPROOF_STATEMENT_SIGNING_PRIVATE_KEY_HEX=

# One checkpoint per event so a judge sees the batched lifecycle anchor during a
# live demo rather than waiting for a production-sized batch to fill.
CREATORPROOF_TRANSPARENCY_CHECKPOINT_INTERVAL=1
CREATORPROOF_TRANSPARENCY_CHECKPOINT_MAX_AGE_SECONDS=30

# ---------------------------------------------------------------------------
# Fail-closed chain policy. `eas` is explicit: no silent fallback to the local
# transparency receipt, and `proof_require_chain` additionally forces the chain
# id and the attester address to be pinned before the process starts.
# ---------------------------------------------------------------------------
CREATORPROOF_PROOF_ANCHOR_MODE=eas
CREATORPROOF_PROOF_REQUIRE_CHAIN=true
CREATORPROOF_PROOF_LOG_PATH=./data/proof-log.jsonl

# --- Variant A: local Ganache harness (blockchain-local/deploy.mjs) ---------
# Values come from the printed deployment.json. `confirmation_depth` is correct
# here only because Ganache has no safe/finalized block tags; a public network
# must use `safe` or `finalized`.
CREATORPROOF_EAS_RPC_URL=http://127.0.0.1:8545
CREATORPROOF_EAS_RPC_URLS_JSON=["http://127.0.0.1:8545"]
CREATORPROOF_EAS_CHAIN_ID=31337
CREATORPROOF_EAS_NETWORK_LABEL=Local EVM (development harness, not a public chain)
CREATORPROOF_EAS_FINALITY_POLICY=confirmation_depth
CREATORPROOF_EAS_REQUIRED_CONFIRMATIONS=1
CREATORPROOF_EAS_CONTRACT_ADDRESS=
CREATORPROOF_EAS_SCHEMA_REGISTRY_ADDRESS=
CREATORPROOF_EAS_EXPECTED_CONTRACT_CODE_SHA256=
CREATORPROOF_EAS_SCHEMA_UID=
CREATORPROOF_EAS_CHECKPOINT_SCHEMA_UID=
CREATORPROOF_EAS_COATTESTATION_SCHEMA_UID=
CREATORPROOF_EAS_MEMBER_REGISTRY_ADDRESS=
CREATORPROOF_EAS_CLEARANCE_RECEIPT_ADDRESS=
CREATORPROOF_EAS_PRIVATE_KEY=
CREATORPROOF_EAS_REQUIRED_ATTESTER_ADDRESS=

# --- Variant B: Base Sepolia (public testnet) ------------------------------
# Uncomment this block and comment out Variant A. Provision the three schemas
# with scripts/provision_eas_base_sepolia.py, deploy CreatorProofNetwork.sol,
# then pin every value below.
# CREATORPROOF_EAS_RPC_URL=https://sepolia.base.org
# CREATORPROOF_EAS_RPC_URLS_JSON=["https://sepolia.base.org"]
# CREATORPROOF_EAS_CHAIN_ID=84532
# CREATORPROOF_EAS_NETWORK_LABEL=Base Sepolia
# CREATORPROOF_EAS_FINALITY_POLICY=safe
# CREATORPROOF_EAS_REQUIRED_CONFIRMATIONS=2
# CREATORPROOF_EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021
# CREATORPROOF_EAS_SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020
# CREATORPROOF_EAS_EXPLORER_TX_BASE_URL=https://sepolia-explorer.base.org/tx
# CREATORPROOF_EAS_EXPLORER_ADDRESS_BASE_URL=https://sepolia-explorer.base.org/address
# CREATORPROOF_EAS_EXPLORER_ATTESTATION_BASE_URL=https://base-sepolia.easscan.org/attestation/view

CREATORPROOF_EAS_SCHEMA_DEFINITION=bytes32 packetHash
CREATORPROOF_EAS_CHECKPOINT_SCHEMA_DEFINITION=bytes32 checkpointHash
CREATORPROOF_EAS_COATTESTATION_SCHEMA_DEFINITION=bytes32 coAttestationHash
CREATORPROOF_EAS_RECIPIENT=0x0000000000000000000000000000000000000000
CREATORPROOF_EAS_RECEIPT_TIMEOUT_SECONDS=90
CREATORPROOF_EAS_MAX_ATTEMPTS=3
CREATORPROOF_EAS_RETRY_BACKOFF_SECONDS=3
CREATORPROOF_EAS_MAX_FEE_PER_GAS_GWEI=0

# ---------------------------------------------------------------------------
# Multi-party attestation. This is what makes the prototype a network rather
# than one vendor timestamping its own database, so the profile requires it.
# ---------------------------------------------------------------------------
CREATORPROOF_BLOCKCHAIN_DOMAIN_ANCHORING_ENABLED=true
CREATORPROOF_BLOCKCHAIN_DISPATCH_INTERVAL_SECONDS=2
CREATORPROOF_BLOCKCHAIN_ANCHOR_LEASE_SECONDS=180
CREATORPROOF_BLOCKCHAIN_ANCHOR_MAX_ATTEMPTS=8
CREATORPROOF_BLOCKCHAIN_ANCHOR_RETRY_BACKOFF_SECONDS=5
CREATORPROOF_BLOCKCHAIN_COUNTERPARTY_ATTESTATION_ENABLED=true
CREATORPROOF_COUNTERPARTY_ATTESTATION_DOMAIN_NAME=CreatorProofNetwork
CREATORPROOF_COUNTERPARTY_ATTESTATION_DOMAIN_VERSION=1
CREATORPROOF_COUNTERPARTY_ATTESTATION_MAX_AGE_SECONDS=900
CREATORPROOF_COUNTERPARTY_MEMBERSHIP_REQUIRED=true
