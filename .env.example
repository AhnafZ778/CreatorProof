# Development only. Replace before any shared deployment.
CREATORPROOF_ENVIRONMENT=development
CREATORPROOF_DEV_API_KEY=change-me-before-sharing
CREATORPROOF_DEV_AUTH_ENABLED=true
CREATORPROOF_API_KEY_PEPPER=creatorproof-development-pepper
CREATORPROOF_ENABLE_POSTGRES_RLS=true
CREATORPROOF_DATABASE_URL=sqlite:///./creatorproof.db
CREATORPROOF_STORAGE_ROOT=./data
# Compose deliberately separates the PostgreSQL owner used by the one-shot
# migration service from the NOBYPASSRLS runtime login. The built-in values are
# local-development credentials only. For an external deployment, provision both
# roles separately and override the complete URLs (URL-encode special characters).
# CREATORPROOF_POSTGRES_OWNER_PASSWORD=creatorproof-dev
# CREATORPROOF_POSTGRES_RUNTIME_PASSWORD=creatorproof-app-dev
# CREATORPROOF_MIGRATION_DATABASE_URL=postgresql+psycopg://creatorproof@postgres:5432/creatorproof
# CREATORPROOF_RUNTIME_DATABASE_URL=postgresql+psycopg://creatorproof_app@postgres:5432/creatorproof
# `local` returns the scan ID immediately and runs one background scan at a time.
# Use `redis` with the worker service for a durable deployment queue. Legacy
# `inline` is automatically migrated to local-thread outside the test environment.
CREATORPROOF_JOB_BACKEND=local
CREATORPROOF_LOCAL_JOB_WORKERS=1
CREATORPROOF_REDIS_URL=redis://localhost:6379/0
CREATORPROOF_REDIS_QUEUE_NAME=creatorproof:scans
CREATORPROOF_REDIS_JOB_MAX_ATTEMPTS=3
CREATORPROOF_REDIS_JOB_LEASE_SECONDS=1800
CREATORPROOF_REDIS_JOB_RECOVERY_INTERVAL_SECONDS=30
CREATORPROOF_REDIS_JOB_CLAIM_TIMEOUT_SECONDS=5
CREATORPROOF_API_URL=http://localhost:8000
# File-backed Part 1 model identity. Strict mode turns an invalid/missing manifest into startup failure.
CREATORPROOF_MODEL_BUNDLE_PATH=./model_lab/bundles/creatorproof-runtime-ready-v1.json
CREATORPROOF_MODEL_BUNDLE_STRICT=false
CREATORPROOF_RUNTIME_LOCK_PATH=./uv.lock
CREATORPROOF_RETRIEVAL_TOP_K=8
CREATORPROOF_COPY_REGIONAL_RETRIEVAL_ENABLED=true
CREATORPROOF_COPY_REGIONAL_CROP_FRACTION=0.64
CREATORPROOF_COPY_REGIONAL_MIN_SHORT_SIDE=192
CREATORPROOF_COPY_REGIONAL_SIMILARITY_PENALTY=0.02
# Verify every work when the declared catalog is within this bound; 0 disables exhaustive expansion.
CREATORPROOF_COPY_EXHAUSTIVE_VERIFICATION_MAX_ENTRIES=64
CREATORPROOF_SSCD_MODEL_PATH=./models/sscd_disc_mixup.torchscript.pt
CREATORPROOF_SSCD_DEVICE=auto
CREATORPROOF_SSCD_EXPECTED_SHA256=
CREATORPROOF_SSCD_MATCH_SIMILARITY=0.75
CREATORPROOF_SSCD_REVIEW_SIMILARITY=0.60
# `LEARNED_REQUIRED` fails closed when SSCD query/reference descriptors are unavailable.
# Use `BASELINE_ALLOWED` only when exhaustive SHA-256 + pHash fallback is approved by policy.
CREATORPROOF_COPY_RETRIEVAL_REQUIREMENT=LEARNED_REQUIRED
# Descriptor matching fails on two kinds of honest reuse for reasons unrelated to
# whether the images match: a horizontal flip, which costs a reposter nothing and
# defeats a keypoint matcher outright, and flat or repetitive work, where the
# ratio test discards every repeated element as ambiguous. Where the learned
# descriptor still puts a reference at or above this similarity but the pixels
# refuse to align, alignment is retried against a mirror and then under relaxed
# matching. A relaxed alignment is never a match on its own. Set to 1.0 to switch
# the extra passes off.
CREATORPROOF_COPY_ALIGNMENT_ESCALATION_SIMILARITY=0.55

# v0.5 corroborated-copy prototype operating points. Calibrate these on your own held-out corpus.
CREATORPROOF_COPY_STRUCTURE_MATCH_SIMILARITY=0.76
CREATORPROOF_COPY_STRUCTURE_VERY_STRONG_SIMILARITY=0.84
CREATORPROOF_COPY_GEOMETRY_VERY_STRONG_QUALITY=0.72
CREATORPROOF_COPY_SSCD_SUPPORT_SIMILARITY=0.55
CREATORPROOF_COPY_GEOMETRY_SSCD_MATCH_SIMILARITY=0.70
CREATORPROOF_COPY_SSCD_VERY_STRONG_SIMILARITY=0.86
CREATORPROOF_COPY_STRUCTURE_SUPPORT_SIMILARITY=0.62
CREATORPROOF_COPY_PHASH_SUPPORT_SIMILARITY=0.78
CREATORPROOF_COPY_GLOBAL_REVIEW_SIMILARITY=0.80
CREATORPROOF_COPY_PHASH_REVIEW_SIMILARITY=0.90
# A small crop of a registered work is where the global descriptor is least
# useful, because it is looking at a different picture, and where aligned pixels
# are most conclusive. A strictly verified alignment with nearly every match
# agreeing and effectively identical overlapping pixels stands without a
# retrieval-side second opinion.
CREATORPROOF_COPY_CONCLUSIVE_STRUCTURE_SIMILARITY=0.97
CREATORPROOF_COPY_CONCLUSIVE_INLIER_RATIO=0.90

# Independent creator-profile resemblance lane. `auto` tries local CSD, then records a transparent fallback.
CREATORPROOF_STYLE_PROVIDER=auto
CREATORPROOF_STYLE_CSD_REPO_PATH=./vendor/CSD
CREATORPROOF_STYLE_CSD_MODEL_PATH=./models/csd-vit-l/pytorch_model.bin
CREATORPROOF_STYLE_DEVICE=auto
CREATORPROOF_STYLE_TOP_K=5

# CSD+ catalog readout and uncalibrated corroborated-style operating points.
CREATORPROOF_STYLE_CSLS_K=15
CREATORPROOF_STYLE_LEARNED_SUPPORT_SIMILARITY=0.68
CREATORPROOF_STYLE_MECHANICS_SUPPORT_SIMILARITY=0.70
CREATORPROOF_STYLE_TILE_SUPPORT_SIMILARITY=0.68
CREATORPROOF_STYLE_CONTENT_GAP_SUPPORT=0.12
CREATORPROOF_STYLE_CATALOG_MARGIN_SUPPORT=0.03
CREATORPROOF_STYLE_EVIDENCE_REVIEW_SIMILARITY=0.58
CREATORPROOF_STYLE_EVIDENCE_HIGH_SIMILARITY=0.74
CREATORPROOF_STYLE_EVIDENCE_VERY_HIGH_SIMILARITY=0.84

# Catalog-relative empirical style support. High tiers remain unavailable until these
# support gates are met; 19 negatives are needed to reach a smoothed p-value of 0.05.
CREATORPROOF_STYLE_MIN_PROFILE_WORKS=3
CREATORPROOF_STYLE_MIN_CALIBRATION_PROFILES=3
CREATORPROOF_STYLE_MIN_CALIBRATION_NEGATIVES=19
CREATORPROOF_STYLE_HIGH_MAX_NEGATIVE_TAIL_P=0.10
CREATORPROOF_STYLE_VERY_HIGH_MAX_NEGATIVE_TAIL_P=0.05
CREATORPROOF_STYLE_HIGH_MIN_POSITIVE_PERCENTILE=0.25
CREATORPROOF_STYLE_VERY_HIGH_MIN_POSITIVE_PERCENTILE=0.50

# Keep legacy pickle loading off unless the pinned checkpoint's measured SHA-256 is supplied.
CREATORPROOF_STYLE_ALLOW_LEGACY_PICKLE=false
CREATORPROOF_STYLE_CSD_EXPECTED_SHA256=
CREATORPROOF_STYLE_CSD_EXPECTED_REPO_REVISION=3a9df32605b869eceb704897839be80977a9f1ea
# No creator is authorized by default. Enroll exact work IDs only with confirmed consent.
CREATORPROOF_STYLE_PROFILE_MANIFEST_PATH=./model_lab/profiles/demo-profiles.v1.json
CREATORPROOF_STYLE_PROFILE_MANIFEST_STRICT=false

# AI-origin lane. With both Sightengine values below, `auto` makes Sightengine's
# `genai` API the primary detector. CreatorProof uploads the original accepted image
# once, preserves Sightengine's global/per-generator response, and uses local models
# only if that request cannot complete. Leave both blank for a local-only setup.
# The official Community Forensics model can be fetched with
# scripts.fetch_community_forensics_model.
CREATORPROOF_SYNTHETIC_DETECTOR=auto
CREATORPROOF_SIGHTENGINE_API_USER=
CREATORPROOF_SIGHTENGINE_API_SECRET=
# One request budget for Sightengine's original-media call. Do not put credentials
# in Git, browser code, logs, Evidence Packets, or screenshots.
CREATORPROOF_SIGHTENGINE_TIMEOUT_SECONDS=20
# `INFORMATIONAL` records the lane without policy authority. `REQUIRED` may route review;
# `DISABLED` deliberately skips origin-model and visible-label checks.
CREATORPROOF_SYNTHETIC_POLICY_MODE=INFORMATIONAL
CREATORPROOF_SYNTHETIC_COMMUNITY_MODEL_PATH=./models/community-forensics-384
CREATORPROOF_SYNTHETIC_COMMUNITY_EXPECTED_SHA256=
CREATORPROOF_SYNTHETIC_TORCHSCRIPT_MODEL_PATH=./models/synthetic-detector.torchscript.pt
CREATORPROOF_SYNTHETIC_DEVICE=auto
CREATORPROOF_SYNTHETIC_EXTERNAL_DETECTORS_JSON=[]
CREATORPROOF_SYNTHETIC_EVIDENCE_FAMILY_REGISTRY_PATH=./model_lab/registries/synthetic-evidence-families.v1.json
CREATORPROOF_SYNTHETIC_CALIBRATION_PATH=./models/synthetic-calibration.json
CREATORPROOF_SYNTHETIC_CALIBRATION_DOMAIN_ID=creatorproof-demo-open-world-v1
CREATORPROOF_SYNTHETIC_CROP_POLICY_ID=creatorproof-origin-multiview-v3
CREATORPROOF_SYNTHETIC_MIN_CALIBRATION_SAMPLES=100
CREATORPROOF_SYNTHETIC_MIN_CALIBRATION_CLASS_SAMPLES=25
CREATORPROOF_SYNTHETIC_LIKELY_THRESHOLD=0.78
CREATORPROOF_SYNTHETIC_REVIEW_THRESHOLD=0.58
CREATORPROOF_SYNTHETIC_MAX_VIEW_STD=0.18
CREATORPROOF_SYNTHETIC_MIN_SHORT_SIDE=128
CREATORPROOF_SYNTHETIC_SPATIAL_CROPS=true
CREATORPROOF_SYNTHETIC_SPATIAL_CROP_FRACTION=0.78
CREATORPROOF_SYNTHETIC_MIN_INDEPENDENT_FAMILIES=2
# Whole-detector budget for every transformed view together, never per view.
CREATORPROOF_SYNTHETIC_EXTERNAL_TIMEOUT_SECONDS=120

# Visible AI-label check. Install Tesseract locally. This can raise review but
# cannot prove origin; a missing label is always neutral.
CREATORPROOF_VISIBLE_AI_MARKER_MODE=auto
CREATORPROOF_VISIBLE_AI_MARKER_BINARY=tesseract
# Whole OCR scan budget across every crop and page-segmentation mode.
CREATORPROOF_VISIBLE_AI_MARKER_TIMEOUT_SECONDS=12
CREATORPROOF_VISIBLE_AI_MARKER_MIN_CONFIDENCE=0.42
CREATORPROOF_VISIBLE_AI_MARKER_TERMS_JSON=[]

# Enrollment gate. Screens every file submitted to POST /v1/works before it is
# written, so a protected-work catalog only ever holds work a person made.
# `BLOCK` refuses a file the origin lane positively identifies as AI-generated;
# `FLAG_ONLY` records the finding and registers anyway; `OFF` skips the check.
# Only a positive finding ever refuses. An unknown, unavailable, inconclusive or
# failed screening always admits the file, because locking an artist out of their
# own catalog over a missing detector is the worse error.
CREATORPROOF_REGISTRATION_ORIGIN_GATE=BLOCK

# How much AI signal refuses a registration, as a share of the ensemble score.
# At or below this line the file is admitted even when a detector raised an
# indicator, so a weak or contested signal does not turn an artist away; above
# it the file is refused. Signed Content Credentials asserting AI generation
# refuse regardless, since there the file is declaring its own origin.
CREATORPROOF_REGISTRATION_ORIGIN_BLOCK_SCORE=0.50

# Recommended second evidence family after cloning the official Apache-2.0 GRIP repo and
# downloading its Git-LFS weights. Keep this JSON on one line in the actual .env file.
# The `{manifest}` command below sends every delivery/crop view through one GRIP
# process, so its large weights are loaded once per scan instead of ten times.
# CREATORPROOF_SYNTHETIC_EXTERNAL_DETECTORS_JSON=[{"name":"grip-clipdet","command":"./.venv/bin/python -m scripts.clipdet_json_adapter --manifest {manifest} --repo ./vendor/ClipBased-SyntheticImageDetection --weights ./vendor/ClipBased-SyntheticImageDetection/weights --runner-python ./vendor/ClipBased-SyntheticImageDetection/.venv/bin/python --device cpu","timeout_seconds":120,"evidence_family":"SEMANTIC_PIXEL_HYBRID","source_scope":"CLIP_SEMANTIC_PLUS_FORENSIC_PIXEL_MODELS"}]

# Official C2PA inspection. Missing Content Credentials remain UNKNOWN origin.
CREATORPROOF_C2PA_MODE=auto
CREATORPROOF_C2PA_BINARY=c2patool
CREATORPROOF_C2PA_EXPECTED_VERSION=0.27.7
CREATORPROOF_C2PA_EXPECTED_BINARY_SHA256=cceb21184cf0f5f3e4dce38275a225ad8ea50d2cda559df7a90ca0737248ad70
CREATORPROOF_C2PA_TIMEOUT_SECONDS=20
CREATORPROOF_C2PA_TRUST_POLICY_ID=creatorproof-c2patool-default-trust-evaluation-v1

# Signed statements and checkpoints are the off-chain trust layer. Generate each
# private key independently; never reuse the EVM key and never commit either value.
CREATORPROOF_STATEMENT_SIGNING_ENABLED=true
CREATORPROOF_STATEMENT_SIGNING_KID=creatorproof-local-ed25519-1
CREATORPROOF_STATEMENT_SIGNING_PRIVATE_KEY_HEX=
# Publish this SHA-256 fingerprint through a channel independent of exported
# packages (competition paper/site/QR). A package cannot establish its own trust root.
CREATORPROOF_TRUSTED_ISSUER_KEY_SHA256=
# These are public browser trust pins, injected at web build time as well as
# runtime. They must match independently published API/deployment fingerprints.
NEXT_PUBLIC_CREATORPROOF_ISSUER_KEY_FINGERPRINT_SHA256=
NEXT_PUBLIC_CREATORPROOF_DEPLOYMENT_FINGERPRINT_SHA256=
NEXT_PUBLIC_CREATORPROOF_ISSUER=creatorproof
# `1` creates a checkpoint for each event and is useful for the competition demo.
# Production should batch by a measured event/time policy to reduce chain writes.
CREATORPROOF_TRANSPARENCY_CHECKPOINT_INTERVAL=1
# Flush a trailing partial batch even if no later event reaches the interval.
CREATORPROOF_TRANSPARENCY_CHECKPOINT_MAX_AGE_SECONDS=60

# Proof mode. `auto` uses EAS only with complete credentials; otherwise it creates
# a local Merkle transparency receipt that the UI explicitly labels NOT BLOCKCHAIN.
# `eas` selects the EAS provider even when its setup is incomplete, making the
# failure visible. `CREATORPROOF_PROOF_REQUIRE_CHAIN=true` prevents any fallback.
CREATORPROOF_PROOF_ANCHOR_MODE=auto
CREATORPROOF_PROOF_REQUIRE_CHAIN=false
CREATORPROOF_PROOF_LOG_PATH=./data/proof-log.jsonl

# Base Sepolia example. RPC, chain, contract, and explorer constants below are
# public values from the Base and EAS projects; the RPC is rate-limited and intended
# for development only. Override the whole network tuple together for another chain.
CREATORPROOF_EAS_RPC_URL=https://sepolia.base.org
# Ordered failover endpoints. Do not put credential-bearing URLs in committed files.
CREATORPROOF_EAS_RPC_URLS_JSON=["https://sepolia.base.org"]
CREATORPROOF_EAS_CHAIN_ID=84532
CREATORPROOF_EAS_NETWORK_LABEL=Base Sepolia
CREATORPROOF_EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021
CREATORPROOF_EAS_SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020
CREATORPROOF_EAS_SCHEMA_DEFINITION=bytes32 packetHash
# Pin the SHA-256 of eth_getCode output after independently verifying the official
# deployment. Leave blank only during initial testnet provisioning.
CREATORPROOF_EAS_EXPECTED_CONTRACT_CODE_SHA256=
# Deployment-specific: register exactly `bytes32 packetHash`, no resolver,
# revocable=true, then place its 32-byte UID here.
CREATORPROOF_EAS_SCHEMA_UID=
# Register a second, non-revocable schema for signed Merkle checkpoints. Keeping a
# distinct UID prevents a lifecycle batch from being misrepresented as a scan packet.
CREATORPROOF_EAS_CHECKPOINT_SCHEMA_DEFINITION=bytes32 checkpointHash
CREATORPROOF_EAS_CHECKPOINT_SCHEMA_UID=
# Third schema for counterparty co-attestations. Revocable, because a member may
# withdraw its own commitment; the platform packet schema stays independent.
CREATORPROOF_EAS_COATTESTATION_SCHEMA_DEFINITION=bytes32 coAttestationHash
CREATORPROOF_EAS_COATTESTATION_SCHEMA_UID=
# Secret: use a dedicated, minimally funded Base Sepolia attester. Inject this
# through your secret store in shared environments; never put a real key in Git.
CREATORPROOF_EAS_PRIVATE_KEY=
# Public address derived independently from the signer and pinned in the trust
# manifest. Production chain-required startup refuses an unpinned attester.
CREATORPROOF_EAS_REQUIRED_ATTESTER_ADDRESS=
CREATORPROOF_EAS_RECIPIENT=0x0000000000000000000000000000000000000000
CREATORPROOF_EAS_EXPLORER_TX_BASE_URL=https://sepolia-explorer.base.org/tx
CREATORPROOF_EAS_EXPLORER_ADDRESS_BASE_URL=https://sepolia-explorer.base.org/address
CREATORPROOF_EAS_EXPLORER_ATTESTATION_BASE_URL=https://base-sepolia.easscan.org/attestation/view
CREATORPROOF_EAS_RECEIPT_TIMEOUT_SECONDS=90
# Two Base Sepolia blocks is a demo policy, not economic finality. Production must
# set this from a documented risk policy and reconcile previously mined receipts.
CREATORPROOF_EAS_REQUIRED_CONFIRMATIONS=2
# `safe` waits until the RPC safe block covers the attestation. Production accepts
# only `safe` or `finalized`; `confirmation_depth` is development compatibility.
CREATORPROOF_EAS_FINALITY_POLICY=safe
CREATORPROOF_EAS_MAX_ATTEMPTS=3
CREATORPROOF_EAS_RETRY_BACKOFF_SECONDS=3
# 0 disables the cap. Set a nonzero maximum before using real funds.
CREATORPROOF_EAS_MAX_FEE_PER_GAS_GWEI=0

# Durable background anchoring for registrations and rights/status events. Events
# are signed and batched into Merkle checkpoints instead of spending one tx each.
CREATORPROOF_BLOCKCHAIN_DOMAIN_ANCHORING_ENABLED=true
CREATORPROOF_BLOCKCHAIN_DISPATCH_INTERVAL_SECONDS=2
CREATORPROOF_BLOCKCHAIN_ANCHOR_LEASE_SECONDS=180
CREATORPROOF_BLOCKCHAIN_ANCHOR_MAX_ATTEMPTS=8
CREATORPROOF_BLOCKCHAIN_ANCHOR_RETRY_BACKOFF_SECONDS=5

# Multi-party attestation. A brand, agency or marketplace signs an EIP-712 payload
# with its own EVM key; only the 32-byte body hash reaches the chain, bound to the
# platform attestation through refUID. Party identity never goes on-chain.
CREATORPROOF_BLOCKCHAIN_COUNTERPARTY_ATTESTATION_ENABLED=true
# Deploy blockchain-local/contracts/CreatorProofNetwork.sol (or its testnet
# equivalent) and pin both addresses. The registry is also the EIP-712 verifying
# contract, so a signature cannot be replayed onto another deployment.
CREATORPROOF_EAS_MEMBER_REGISTRY_ADDRESS=
CREATORPROOF_EAS_CLEARANCE_RECEIPT_ADDRESS=
CREATORPROOF_COUNTERPARTY_ATTESTATION_DOMAIN_NAME=CreatorProofNetwork
CREATORPROOF_COUNTERPARTY_ATTESTATION_DOMAIN_VERSION=1
# How long a collected signature stays presentable, bounding replay by a third party.
CREATORPROOF_COUNTERPARTY_ATTESTATION_MAX_AGE_SECONDS=900
# Refuse an address the on-chain registry does not report ACTIVE. Relax only on a
# development network where no registry is deployed.
CREATORPROOF_COUNTERPARTY_MEMBERSHIP_REQUIRED=true
