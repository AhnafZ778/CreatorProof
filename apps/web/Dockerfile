FROM node:22-alpine AS build
WORKDIR /app
ARG NEXT_PUBLIC_CREATORPROOF_ISSUER_KEY_FINGERPRINT_SHA256=""
ARG NEXT_PUBLIC_CREATORPROOF_DEPLOYMENT_FINGERPRINT_SHA256=""
ARG NEXT_PUBLIC_CREATORPROOF_ISSUER="creatorproof"
ENV NEXT_PUBLIC_CREATORPROOF_ISSUER_KEY_FINGERPRINT_SHA256=$NEXT_PUBLIC_CREATORPROOF_ISSUER_KEY_FINGERPRINT_SHA256 \
    NEXT_PUBLIC_CREATORPROOF_DEPLOYMENT_FINGERPRINT_SHA256=$NEXT_PUBLIC_CREATORPROOF_DEPLOYMENT_FINGERPRINT_SHA256 \
    NEXT_PUBLIC_CREATORPROOF_ISSUER=$NEXT_PUBLIC_CREATORPROOF_ISSUER
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
