CREATORPROOF_API_URL=http://localhost:8000
# Preferred web-server credential name. The legacy DEV name below remains
# supported for local Compose compatibility; set only one in a deployment.
CREATORPROOF_API_KEY=
CREATORPROOF_DEV_API_KEY=change-me-before-sharing
CREATORPROOF_DIRECT_UPLOAD_ENABLED=false
CREATORPROOF_BACKEND_COLD_START_BUDGET_MS=75000

# Production defaults to `basic` and refuses to start without both credentials.
# `public` is an explicit opt-out appropriate only when another access layer is
# in front of Vercel and the backend tenant quota is configured.
CREATORPROOF_WEB_AUTH_MODE=public
CREATORPROOF_WEB_BASIC_AUTH_USER=
CREATORPROOF_WEB_BASIC_AUTH_PASSWORD=

# Optional. This is used only by the server-side Evidence Explainer route.
# Core copy retrieval uses local SSCD and does not need an OpenRouter key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
