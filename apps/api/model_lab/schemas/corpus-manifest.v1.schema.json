{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatorproof.local/schemas/corpus-manifest.v1.schema.json",
  "title": "CreatorProof Corpus Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "dataset_id",
    "lane",
    "partition",
    "domain_id",
    "items"
  ],
  "properties": {
    "schema": {"const": "creatorproof.corpus_manifest.v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "lane": {"enum": ["COPY", "AI_ORIGIN", "CREATOR_PROFILE"]},
    "partition": {"enum": ["TRAIN", "CALIBRATION", "TEST", "DEMO"]},
    "domain_id": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "asset_id",
          "location",
          "sha256",
          "source_lineage_id",
          "rights",
          "exposure_state",
          "label"
        ],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_lineage_id": {"type": "string", "minLength": 1},
          "rights": {
            "type": "object",
            "required": ["state", "reference"],
            "properties": {
              "state": {
                "enum": ["OWNED", "AUTHORIZED", "LICENSED", "PUBLIC_DOMAIN_VERIFIED"]
              },
              "reference": {"type": "string", "minLength": 1}
            }
          },
          "exposure_state": {"enum": ["NEVER_SEEN", "CALIBRATION_SEEN", "DEMO_EXPOSED"]},
          "derived_from_asset_id": {"type": "string"},
          "transformation_id": {"type": "string"},
          "profile_id": {"type": "string"},
          "profile_consent_state": {"enum": ["CONFIRMED", "NOT_CONFIRMED", "WITHDRAWN"]},
          "cohorts": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
