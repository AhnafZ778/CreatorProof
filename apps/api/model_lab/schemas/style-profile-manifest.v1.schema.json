{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatorproof.local/schemas/style-profile-manifest.v1.schema.json",
  "title": "CreatorProof consent-backed style profile manifest",
  "type": "object",
  "required": ["schema", "manifest_id", "profiles"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "creatorproof.style_profile_manifest.v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "profile_version",
          "display_name",
          "enrollment_method",
          "consent",
          "work_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "profile_version": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "enrollment_method": {"type": "string", "minLength": 1},
          "consent": {
            "type": "object",
            "required": ["state", "reference"],
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": ["CONFIRMED", "NOT_CONFIRMED", "REVOKED"]
              },
              "reference": {"type": "string", "minLength": 1}
            }
          },
          "work_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
